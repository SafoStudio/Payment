# PostgreSQL
POSTGRES_DB=payment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Runtime (RLS): app_user — NOSUPERUSER NOBYPASSRLS NOINHERIT, not owner.
# Used by spring.datasource.* AND by the role-provisioning step (see bootstrap below).
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=app_user_change_me

# pgAdmin
PGADMIN_EMAIL=admin@payment.com
PGADMIN_PASSWORD=your_admin_password_here

# Ports
POSTGRES_PORT=5432
PGADMIN_PORT=5050