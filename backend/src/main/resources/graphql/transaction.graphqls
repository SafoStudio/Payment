type Transaction {
    id: ID!
    debitWalletId: ID!
    creditWalletId: ID!
    amount: String!
    currency: String!
    type: TransactionType!
    status: TransactionStatus!
    description: String
    referenceId: ID
    createdAt: String!
}

enum TransactionType {
    TRANSFER
    TOP_UP
    WITHDRAWAL
    REFUND
}

enum TransactionStatus {
    PENDING
    COMPLETED
    FAILED
    CANCELLED
}

input TransferInput {
    fromWalletId: ID!
    toWalletId: ID!
    amount: String!
    currency: String!
    description: String
    idempotencyKey: String!
}

input TopUpInput {
    walletId: ID!
    amount: String!
    currency: String!
    description: String
    idempotencyKey: String!
}

extend type Query {
    transaction(id: ID!): Transaction!
    walletTransactions(walletId: ID!, limit: Int!): [Transaction!]!
}

extend type Mutation {
    transfer(input: TransferInput!): Transaction!
    topUp(input: TopUpInput!): Transaction!
}