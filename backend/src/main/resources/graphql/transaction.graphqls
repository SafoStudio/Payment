type Transaction {
    id: ID!
    debitWalletId: ID!
    creditWalletId: ID!
    amount: String!
    currency: String!
    type: TransactionType!
    status: TransactionStatus!
    description: String
    referenceId: ID
    createdAt: String!
}

enum TransactionType {
    TRANSFER
    TOP_UP
    WITHDRAWAL
    REFUND
    ADJUSTMENT
}

enum TransactionStatus {
    PENDING
    COMPLETED
    FAILED
    CANCELLED
}

input TransactionFilterInput {
    type: TransactionType
    status: TransactionStatus
    currency: String
}

input AdjustBalanceInput {
    walletId: ID!
    amount: String!
    reason: String!
    idempotencyKey: String!
}

type TransactionPage {
    items: [Transaction!]!
    nextCursor: String
    hasMore: Boolean!
}

extend type Query {
    transaction(id: ID!): Transaction!
    walletTransactions(walletId: ID!, limit: Int!): [Transaction!]!
    transactions(filter: TransactionFilterInput, limit: Int = 20, after: String): TransactionPage!
}

extend type Mutation {
    adjustBalance(input: AdjustBalanceInput!): Transaction!
}