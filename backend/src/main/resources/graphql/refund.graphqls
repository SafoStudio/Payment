type Refund {
    id: ID!
    paymentId: ID!
    amount: String!
    currency: String!
    status: RefundStatus!
    reason: String
    originalTransactionId: ID!
    refundTransactionId: ID
    createdAt: String!
    updatedAt: String!
}

enum RefundStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
    REJECTED
}

input CreateRefundInput {
    paymentId: ID!
    amount: String!
    currency: String!
    reason: String
    idempotencyKey: String!
}

input RefundFilterInput {
    status: RefundStatus
    currency: String
}

type RefundPage {
    items: [Refund!]!
    nextCursor: String
    hasMore: Boolean!
}

extend type Query {
    refund(id: ID!): Refund
    refundsByPayment(paymentId: ID!): [Refund!]!
    refunds(filter: RefundFilterInput, limit: Int = 20, after: String): RefundPage!
}

extend type Mutation {
    createRefund(input: CreateRefundInput!): Refund!
    processRefund(id: ID!): Refund!
}