type User {
    id: ID!
    email: String!
    phone: String
    firstName: String!
    lastName: String!
    fullName: String!
    roles: [String!]!
    permissions: [String!]!
    hasPasskey: Boolean
    status: UserStatus!
    wallets: [Wallet!]!
    createdAt: String!
    updatedAt: String!
}

enum UserStatus {
    ACTIVE
    BLOCKED
    DELETED
}

input CreateUserInput {
    email: String!
    phone: String
    firstName: String!
    lastName: String!
    roleCodes: [String!]!
}

input UpdateUserInput {
    email: String
    phone: String
    firstName: String
    lastName: String
}

input UserFilterInput {
    status: UserStatus
    roleCode: String
}

type UserPage {
    items: [User!]!
    nextCursor: String
    hasMore: Boolean!
}

extend type Query {
    me: User!
    user(id: ID!): User!
    userByEmail(email: String!): User!
    users(filter: UserFilterInput, limit: Int = 20, after: String): UserPage!
    activeUsers: [User!]!
    usersByRole(roleCode: String!): [User!]!
}

extend type Mutation {
    createUser(input: CreateUserInput!): User!
    updateUser(id: ID!, input: UpdateUserInput!): User!
    blockUser(id: ID!): User!
    activateUser(id: ID!): User!
    deleteUser(id: ID!): User!
    assignRoles(userId: ID!, roleCodes: [String!]!): User!
    addRole(userId: ID!, roleCode: String!): User!
    removeRole(userId: ID!, roleCode: String!): User!
}