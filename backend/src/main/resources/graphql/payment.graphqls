type Payment {
    id: ID!
    walletId: ID!
    targetWalletId: ID!
    amount: String!
    currency: String!
    status: PaymentStatus!
    type: PaymentType!
    idempotencyKey: String
    description: String
    transactionId: ID
    createdAt: String!
    updatedAt: String!
}

type PaymentPage {
    items: [Payment!]!
    nextCursor: String
    hasMore: Boolean!
}

enum PaymentStatus {
    PENDING
    PROCESSING
    SUCCEEDED
    FAILED
    REFUNDED
    CANCELLED
}

enum PaymentType {
    TRANSFER
    TOP_UP
    WITHDRAWAL
    REFUND
    PAYMENT
}

input CreatePaymentInput {
    targetWalletId: ID!
    amount: String!
    currency: String!
    idempotencyKey: String!
    description: String
}

input PaymentFilterInput {
    status: PaymentStatus
    type: PaymentType
    currency: String
}

extend type Query {
    payment(id: ID!): Payment!
    paymentByIdempotencyKey(key: String!): Payment
    paymentsByWallet(walletId: ID!): [Payment!]!
    payments(filter: PaymentFilterInput, limit: Int = 20, after: String): PaymentPage!
}

extend type Mutation {
    createPayment(input: CreatePaymentInput!): Payment!
    processPayment(id: ID!): Payment!
    cancelPayment(id: ID!): Payment!
}